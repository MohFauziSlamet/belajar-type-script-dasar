{
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  // "exclude": [
  //   "tests/**/*"
  // ],
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "outDir": "dist/",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "target": "esnext",
    "types": [
      "jest"
    ],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    // noUncheckedIndexedAccess DIMATIKAN sengaja (keputusan 2026-08-26):
    // flag ini membuat arr[i] bertipe "T | undefined" sehingga latihan dasar
    // seperti a + arr[0] error sebelum materi null-handling diajarkan.
    // strict: true tetap NYALA (itu standar kelas ini).
    // "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes DIMATIKAN sengaja (keputusan 2026-08-27,
    // sesi 19): flag ini menolak `alamat: undefined` eksplisit pada property
    // optional (TS2375) — padahal itu pola standar TS dan mengikuti perilaku
    // yang diajarkan materi. strict: true tetap NYALA.
    // "exactOptionalPropertyTypes": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
  }
}